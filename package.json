{
  "name": "ouroboros-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:css": "tailwindcss -i src/ui/styles/tailwind.source.css -o src/ui/styles/tailwind.generated.css --minify",
    "dev": "npm run build:css && tsx src/server.ts",
    "start": "tsx src/server.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "tsx": "^4.20.6"
  }
}
