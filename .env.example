# Ouroboros Node runtime environment variables
# At least one AI API key AND GITHUB_TOKEN are required to start

# Required
GITHUB_TOKEN=

# AI provider keys (at least one required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Laya (optional, for local decision backend)
LAYA_API_KEY=

# Server
PORT=3000
OURO_DATA_DIR=./data
OURO_DB_PATH=./data/ouroboros.sqlite

# DB driver (node:sqlite in-process is the default; Docker compose uses rqlite)
# OURO_DB=rqlite
# OURO_RQLITE_URL=http://127.0.0.1:4001

# Registration
OURO_REGISTRATION_ENABLED=false

